# Database Configuration
# For PostgreSQL locally: postgresql://postgres:password@localhost:5432/crop_zen
# For lightweight local tests: sqlite:///crop_zen_test.db
# For production, update with secure credentials
DATABASE_URL=postgresql://postgres:password@localhost:5432/crop_zen
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Authentication
# Generate a strong SECRET_KEY in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LOG_FOLDER=logs

# CORS Settings
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=5242880

# ML Model Paths
CROP_MODEL_PATH=ml_models/crop_recommendation_model.joblib
DISEASE_MODEL_PATH=ml_models/disease_detection_model.keras
DISEASE_LABELS_PATH=ml_models/disease_labels.json
